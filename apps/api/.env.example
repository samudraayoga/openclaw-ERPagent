# ========================
# RAHO API — Environment Variables
# Copy ke .env dan sesuaikan nilainya
# ========================

# ── Application ─────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
API_URL=https://erp.rahopremier.id

# ── RAIN / OpenClaw ──────────────────────────────
# Gateway dan API berada pada host/network namespace yang sama pada V1.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# Wajib di production. Simpan sebagai secret dan jangan commit nilai aslinya.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=rain
OPENCLAW_REQUEST_TIMEOUT_MS=120000

# ── Database (PostgreSQL) ────────────────────────
# Sudah dikonfigurasi di docker-compose.dev.yml
DATABASE_URL=""
# Opsional: beberapa database yang dapat dipilih SUPER_ADMIN saat API berjalan.
# URL hanya dibaca server dan tidak pernah dikirim ke browser.
# DATABASE_PROFILES_JSON='[{"id":"dummy","label":"Database Dummy","url":"postgresql://user:pass@localhost:5432/raho_dummy?schema=public"},{"id":"production","label":"Database Production","url":"postgresql://user:pass@localhost:5432/raho_prod?schema=public"}]'
# DATABASE_DEFAULT_PROFILE_ID=dummy
# Kunci enkripsi profile yang ditambahkan melalui UI. Jika kosong, API memakai
# ZOHO_TOKEN_ENCRYPTION_KEY sebagai fallback untuk kompatibilitas.
# RUNTIME_CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Wajib database disposable terpisah; namanya harus mengandung test/testing,
# restore, atau rehearsal. Jangan pernah samakan dengan DATABASE_URL aplikasi.
TEST_DATABASE_URL=""
# Default false agar SQL polling/background worker tidak memenuhi console.
# Aktifkan sementara hanya ketika sedang mendiagnosis query database.
PRISMA_QUERY_LOG=false

# ── JWT Tokens ───────────────────────────────────
JWT_ACCESS_SECRET=raho_access_secret_key_2026_production_secure_token
JWT_REFRESH_SECRET=raho_refresh_secret_key_2026_production_secure_token
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=1d

# ── MinIO Object Storage ─────────────────────────
# Sudah dikonfigurasi di docker-compose.dev.yml
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=raho_minio_user
MINIO_SECRET_KEY=raho_minio_secret
MINIO_BUCKET=raho-uploads
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# ── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Kunci stabil minimal 32 karakter untuk menyimpan kode voucher yang dapat diexport ulang.
# Di production wajib disimpan sebagai secret dan tidak boleh dirotasi tanpa re-enkripsi data lama.
VOUCHER_CODE_ENCRYPTION_KEY=

# WhatsApp session reports stay disabled until consent, encryption key,
# Baileys pairing, and worker readiness have been verified.
WHATSAPP_ENABLED=false
WHATSAPP_WORKER_ENABLED=false
WHATSAPP_PROVIDER=DISABLED
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_WORKER_INTERVAL_MS=5000
WHATSAPP_QR_TIMEOUT_MS=60000

# ── Zoho Books OAuth ─────────────────────────────────────────
# Buat Server-based Application di https://api-console.zoho.com/
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho/callback
# Minimal 32 karakter; gunakan nilai acak yang stabil dan simpan sebagai server secret.
ZOHO_TOKEN_ENCRYPTION_KEY=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_WEB_REDIRECT_URL=http://localhost:3000/admin/integrations/zoho
ZOHO_REQUIRED_SCOPE_VERSION=12
ZOHO_GRNI_SLA_DAYS=7
ZOHO_TREATMENT_REVENUE_MODE=DOCUMENT
ZOHO_CONTACT_RAHO_ID_CUSTOM_FIELD_ID=
ZOHO_CONTACT_RAHO_ID_CUSTOM_FIELD_API_NAME=
ZOHO_SYNC_DRY_RUN=true
ZOHO_SYNC_WORKER_ENABLED=false
ZOHO_SYNC_WORKER_INTERVAL_MS=5000
ZOHO_SYNC_BATCH_SIZE=10
ZOHO_SYNC_MAX_ATTEMPTS=8
ZOHO_SYNC_LEASE_MS=60000
ZOHO_WEBHOOK_SECRET=
ZOHO_RECONCILIATION_ENABLED=false
ZOHO_RECONCILIATION_INTERVAL_MS=3600000
